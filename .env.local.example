# ==============================================
# KaiNova - Environment Variables Template
# Copy this to .env.local and fill in your values
# ==============================================

# Database (Supabase PostgreSQL)
DATABASE_URL="postgresql://postgres:YOUR_PASSWORD@db.YOUR_PROJECT.supabase.co:5432/postgres"
DIRECT_URL="postgresql://postgres:YOUR_PASSWORD@db.YOUR_PROJECT.supabase.co:5432/postgres"

# Supabase
SUPABASE_URL="https://YOUR_PROJECT.supabase.co"
SUPABASE_ANON_KEY="your-supabase-anon-key"
SUPABASE_SERVICE_KEY="your-supabase-service-role-key"
SUPABASE_JWT_SECRET="your-jwt-secret"

# Solana
SOLANA_RPC_URL="https://mainnet.helius-rpc.com/?api-key=YOUR_HELIUS_KEY"
SOLANA_NETWORK="mainnet-beta"
ADMIN_WALLET_ADDRESS="Zf5gMGdiipHjRb4RgJynAhn5NJ68Zy4iWDdKE2g8sU5"
PLATFORM_WALLET_SECRET_KEY="YOUR_BASE58_WALLET_SECRET"

# Upstash Redis
UPSTASH_REDIS_REST_URL="https://YOUR_ID.upstash.io"
UPSTASH_REDIS_REST_TOKEN="your-upstash-token"

# Jupiter
JUPITER_API_URL="https://quote-api.jup.ag/v6"
JUPITER_API_KEY="your-jupiter-api-key"

# Helius
HELIUS_API_KEY="your-helius-api-key"

# App
NEXT_PUBLIC_APP_URL="https://kainova.xyz"
NEXT_PUBLIC_LAUNCH_FEE_SOL="0.035"
NEXT_PUBLIC_ADMIN_WALLET="Zf5gMGdiipHjRb4RgJynAhn5NJ68Zy4iWDdKE2g8sU5"

# Cron secret (generate a random string for Vercel cron auth)
CRON_SECRET="generate-a-random-secret-here"

# Node env
NODE_ENV="development"
